# FireWatch Backend - Variáveis de ambiente
# Copie este arquivo para .env e ajuste conforme necessário

# URL base da API Open-Meteo
# OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast

# Timeout em segundos para chamadas à Open-Meteo
# OPEN_METEO_TIMEOUT=10

# Tempo de vida do cache em segundos
# CACHE_TTL_SEGUNDOS=300

# Permite fallback para estimativa offline (somente desenvolvimento/demonstração offline)
# PERMITIR_FALLBACK_CLIMA=false

# Origens web permitidas, separadas por vírgula. Sem curingas; vazio bloqueia CORS.
# CORS_ORIGINS=https://app.exemplo.com

# Consultas por IP/minuto em cada processo (configurar também no proxy se houver réplicas)
# RISK_RATE_PER_MINUTE=60
# REGIONAL_RATE_PER_MINUTE=6

# ---- Banco de dados (PostgreSQL) ----
# Opcao A (padrao, desenvolvimento local):
DB_NAME=firewatch_db
DB_USER=postgres
DB_PASSWORD=sua_senha_segura
DB_HOST=localhost
DB_PORT=5432
DB_POOL_MIN=1
DB_POOL_MAX=5
DB_CONNECT_TIMEOUT=10
DB_COMMAND_TIMEOUT=30

# Artefato do modelo logístico; transferir separadamente e não versionar no Git.
# MODEL_PATH=/opt/firewatch/modelo_risco_fogo_logistica.joblib

# Em produção, mantenha o PostgreSQL acessível apenas localmente ou por rede privada.
